# Settings for the LAUNCH dashboard. Copy to .env.local to change them.
# Two of them are secrets: UNITAID_FORMS_TOKEN and UNITAID_NOTIFY_TOKEN.
# None is NEXT_PUBLIC_: nothing here reaches the visitor's browser.

# Where the published dataset is read from, on the server, at most every
# 5 minutes. {locale} becomes en, fr or pt: one file per language.
# Optional: this address is the default.
LAUNCH_DATA_URL=https://quantum-sage-technologies.github.io/unitaid-launch-data/v1/dashboard.{locale}.json

# Subscribe for updates, Send feedback and the "Unsubscribe?" page post to
# this site's own routes (/api/unitaid/subscribe, /feedback, /unsubscribe),
# which pass each form on, server to server, to the LAUNCH forms service.
# Its address: https only (http only for localhost), no trailing path after
# /functions/v1. The LAUNCH team gives you the value.
UNITAID_FORMS_URL=
# The token this site sends the forms service ("Authorization: Bearer"). A
# secret, at least 32 characters; the LAUNCH team gives you the value by a
# private channel. Never commit it. Either setting unset (or the token too
# short): Subscribe is hidden, Send feedback is not connected, and the three
# routes answer 503. Read on each request by the routes; the page reads it
# when it is built and every 5 minutes after (see the README, "Forms routes").
UNITAID_FORMS_TOKEN=

# The shared token the LAUNCH pipeline sends to POST /api/unitaid/notifications
# ("Authorization: Bearer <token>"). A secret: make one with
#   openssl rand -hex 32
# set it on the server only, give the same value to the LAUNCH team, and never
# commit it. Never in a NEXT_PUBLIC_ setting. Read on each request, so no new
# build is needed. Not set: every notification is refused (503).
UNITAID_NOTIFY_TOKEN=
