# Settings for the LAUNCH dashboard. Copy to .env.local to change them.
# None of these is a secret: this app holds no keys.

# Where the published dataset is read from, on the server, at most every
# 5 minutes. {locale} becomes en, fr or pt: one file per language.
# Optional: this address is the default.
LAUNCH_DATA_URL=https://quantum-sage-technologies.github.io/unitaid-launch-data/v1/dashboard.{locale}.json

# Where Subscribe for updates and Send feedback post. An address, not a key:
# NEXT_PUBLIC_ settings are copied into the visitor's browser, so a key must
# never go in one.
NEXT_PUBLIC_LAUNCH_FORMS_URL=https://launch-development-test.vercel.app
